Delete all occurrences of a key in DLL

# Definition of doubly linked list:
# class ListNode:
#     def __init__(self, val=0, next=None, prev=None):
#         self.val = val
#         self.next = next
#         self.prev = prev

class Solution:
    def deleteAllOccurrences(self, head, target):
        temp=head
        while temp:
            if temp.val==target:
                if temp==head:
                    head=head.next
                next_node=temp.next
                prev_node=temp.prev
                if next_node:
                    next_node.prev = prev_node
                if prev_node:
                    prev_node.next=next_node
                temp=next_node
            else:
                temp=temp.next
        return head
        
